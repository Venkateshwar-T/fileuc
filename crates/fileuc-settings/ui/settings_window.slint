import { Button, CheckBox, ComboBox, LineEdit } from "std-widgets.slint";

export component SettingsWindow inherits Window {
    title: "FileUC Settings";
    width: 480px;
    height: 520px;
    background: #181920;
    default-font-family: "Segoe UI";

    in-out property <string> trigger_modifier: "Ctrl";
    in-out property <string> hud_style: "Donut";
    in-out property <string> output_mode_text: "Next to original";
    in-out property <string> custom_output_path: "";
    in-out property <string> theme_choice: "System";
    in-out property <string> accent_color: "#7C5CFC";
    in-out property <bool> auto_start: false;
    in-out property <string> ffmpeg_status: "Detected in PATH";

    callback save_clicked();
    callback cancel_clicked();
    callback browse_output_folder();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        Text {
            text: "FileUC Preferences";
            font-size: 20px;
            font-weight: 700;
            color: #FFFFFF;
        }

        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "Trigger Modifier:";
                font-size: 14px;
                color: #D0D2D8;
                vertical-alignment: center;
                width: 140px;
            }
            ComboBox {
                model: ["Ctrl", "Alt", "Shift"];
                current-value: root.trigger_modifier;
                selected(val) => { root.trigger_modifier = val; }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "HUD Style:";
                font-size: 14px;
                color: #D0D2D8;
                vertical-alignment: center;
                width: 140px;
            }
            ComboBox {
                model: ["Donut", "Pill"];
                current-value: root.hud_style;
                selected(val) => { root.hud_style = val; }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "Theme:";
                font-size: 14px;
                color: #D0D2D8;
                vertical-alignment: center;
                width: 140px;
            }
            ComboBox {
                model: ["System", "Dark", "Light"];
                current-value: root.theme_choice;
                selected(val) => { root.theme_choice = val; }
            }
        }

        CheckBox {
            text: "Launch FileUC on Windows startup";
            checked: root.auto_start;
            toggled => { root.auto_start = self.checked; }
        }

        VerticalLayout {
            spacing: 6px;
            Text {
                text: "Output Location:";
                font-size: 14px;
                color: #D0D2D8;
            }
            ComboBox {
                model: ["Next to original", "Custom folder"];
                current-value: root.output_mode_text;
                selected(val) => { root.output_mode_text = val; }
            }
        }

        HorizontalLayout {
            Text {
                text: "FFmpeg Media Converter: " + root.ffmpeg_status;
                font-size: 12px;
                color: #8E92A0;
            }
        }

        Rectangle {}

        HorizontalLayout {
            alignment: end;
            spacing: 12px;

            Button {
                text: "Cancel";
                clicked => { root.cancel_clicked(); }
            }
            Button {
                text: "Save Preferences";
                primary: true;
                clicked => { root.save_clicked(); }
            }
        }
    }
}
